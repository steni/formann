#!/usr/bin/env bats
bats_require_minimum_version 1.5.0

# blocked-passes counts Blocked comments since the latest Implementation
# comment, read through "Read the issue" (`gh issue view --json comments`).
# The `gh` shim serves $GH_COMMENTS_JSON and records its argv.

setup() {
  load 'test_helper/bats-support/load'
  load 'test_helper/bats-assert/load'

  HERE="$(cd "$(dirname "$BATS_TEST_FILENAME")" && pwd)"
  BLOCKED_PASSES="$HERE/../blocked-passes"

  FAKE_BIN="$BATS_TEST_TMPDIR/bin"
  mkdir -p "$FAKE_BIN"
  CALL_LOG="$BATS_TEST_TMPDIR/gh-calls.log"
  : >"$CALL_LOG"
  cat >"$FAKE_BIN/gh" <<'SHIM'
#!/usr/bin/env bash
echo "$*" >>"$CALL_LOG"
if [ "$1" = "issue" ] && [ "$2" = "view" ]; then
  prior=$(wc -l <"$CALL_LOG" | tr -d ' ')
  if [ "$prior" -le "${FAIL_FIRST_N:-0}" ]; then
    echo "gh: API rate limit exceeded" >&2; exit 1
  fi
  printf '%s' "$GH_COMMENTS_JSON"
  exit 0
fi
echo "shim: unexpected gh command: $*" >&2
exit 1
SHIM
  chmod +x "$FAKE_BIN/gh"
  export CALL_LOG
  export PATH="$FAKE_BIN:$PATH"
  export GH_TRACKER_REPO="test-owner/test-repo"
}

# Build a `{"comments":[…]}` document from comment bodies (one per arg).
comments_json() {
  jq -n '{comments: [$ARGS.positional[] | {author: {login: "x"}, body: .}]}' --args "$@"
}

impl='### Implementation — 2026-11-01

> *This was generated by AI during implementation.*

body'
blocked() { printf '### Blocked%s — 2026-11-0%s\n\n> *This was generated by AI during review.*\n\npreview-daemon: connection refused' "${2:-}" "$1"; }

@test "blocked-passes — no comments counts 0" {
  export GH_COMMENTS_JSON='{"comments":[]}'
  run "$BLOCKED_PASSES" '#7'
  assert_success
  assert_output "0"
}

@test "blocked-passes — reads the issue through gh issue view --json comments" {
  export GH_COMMENTS_JSON='{"comments":[]}'
  run "$BLOCKED_PASSES" '#7'
  assert_success
  grep -qx 'issue view 7 --repo test-owner/test-repo --json comments' "$CALL_LOG"
}

@test "blocked-passes — counts Blocked comments after the Implementation comment" {
  GH_COMMENTS_JSON="$(comments_json "$impl" "$(blocked 2)" "### Review (AFK gate) — 2026-11-02" "$(blocked 3)")"
  export GH_COMMENTS_JSON
  run "$BLOCKED_PASSES" '#7'
  assert_success
  assert_output "2"
}

@test "blocked-passes — same-day suffixed Blocked headings count" {
  GH_COMMENTS_JSON="$(comments_json "$impl" "$(blocked 2)" "$(blocked 2 ' (2)')" "$(blocked 2 ' (3)')")"
  export GH_COMMENTS_JSON
  run "$BLOCKED_PASSES" '#7'
  assert_success
  assert_output "3"
}

@test "blocked-passes — a new Implementation comment resets the count" {
  GH_COMMENTS_JSON="$(comments_json "$impl" "$(blocked 2)" "$(blocked 3)" \
    '### Implementation (2) — 2026-11-04' "$(blocked 5)")"
  export GH_COMMENTS_JSON
  run "$BLOCKED_PASSES" '#7'
  assert_success
  assert_output "1"

  GH_COMMENTS_JSON="$(comments_json "$impl" "$(blocked 2)" "$(blocked 3)" '### Implementation — 2026-11-04')"
  export GH_COMMENTS_JSON
  run "$BLOCKED_PASSES" '#7'
  assert_success
  assert_output "0"
}

@test "blocked-passes — without an Implementation comment, every Blocked comment counts" {
  GH_COMMENTS_JSON="$(comments_json "$(blocked 1)" "$(blocked 2)")"
  export GH_COMMENTS_JSON
  run "$BLOCKED_PASSES" '7'
  assert_success
  assert_output "2"
}

@test "blocked-passes — only the heading line classifies; mentions and look-alike kinds do not count" {
  GH_COMMENTS_JSON="$(comments_json "$impl" \
    $'plain web-UI note\n### Blocked — 2026-11-02' \
    '### Blocked by — 2026-11-02' \
    '### Blockedness — 2026-11-02' \
    $'### Blocked — 2026-11-02\r\n\r\nCRLF body')"
  export GH_COMMENTS_JSON
  run "$BLOCKED_PASSES" '#7'
  assert_success
  assert_output "1"
}

@test "blocked-passes — retries a transient gh failure" {
  export FAIL_FIRST_N=1
  GH_COMMENTS_JSON="$(comments_json "$impl" "$(blocked 2)")"
  export GH_COMMENTS_JSON
  run --separate-stderr "$BLOCKED_PASSES" '#7'
  assert_success
  assert_output "1"
}

@test "blocked-passes — persistent gh failure exits 3" {
  export FAIL_FIRST_N=99
  export GH_COMMENTS_JSON='{"comments":[]}'
  run "$BLOCKED_PASSES" '#7'
  assert_failure 3
}

@test "blocked-passes — a non-issue ref is a usage error" {
  run "$BLOCKED_PASSES" 'f/01'
  assert_failure 2
  run "$BLOCKED_PASSES"
  assert_failure 2
}
