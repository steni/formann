#!/usr/bin/env bash
# Emit KEY=value lines for the runner's sandbox env:
#   GH_TOKEN=<token>         — GitHub personal-access token (from the host's secret store)
#   GH_REPO=<owner>/<repo>   — GitHub repo, derived from the host repo's origin remote
#
# Usage (invoked by the runner's collect_binding_env hook):
#   sandbox-env
#
# Output:
#   stdout — GH_TOKEN=<token> followed by GH_REPO=owner/repo
#   stderr — diagnostics on failure. The token is NEVER written to stderr.
#
# Exit codes:
#   0 — both lines printed
#   1 — secret-store entry missing/unreadable, no origin remote, or non-github.com origin
#   2 — environment problem (OS unsupported, no secret-store tool on the host).
#
# Secret-store coordinates — the same shape the runner uses for its own OAuth
# token (runner/retrieve-secret.sh), so one host setup serves both:
#   service: formann-gh-token
#   account: github
#
# To populate (one-time setup):
#   macOS Keychain:
#     security add-generic-password -s formann-gh-token -a github -w
#   Linux — libsecret (GNOME Keyring, KWallet, …):
#     secret-tool store --label=formann-gh-token service formann-gh-token account github
#   Linux — kernel keyring (headless hosts; keyutils package). Add to the user
#   keyring so every login session of the runner's user finds it:
#     keyctl padd user formann_gh_token_github @u
#   (paste your GitHub token at the prompt — no trailing newline)

set -euo pipefail

GH_KEYCHAIN_SERVICE="formann-gh-token"
GH_KEYCHAIN_ACCOUNT="github"

# Prints the token on stdout; on failure, a how-to on stderr and a non-zero
# exit (1 missing/unreadable, 2 no tool). Nothing retrieved is ever echoed to
# stderr.
retrieve_gh_token() {
  if [[ "$OSTYPE" == darwin* ]]; then
    if ! command -v security >/dev/null 2>&1; then
      echo "sandbox-env: 'security' binary not found; cannot retrieve GH token from Keychain" >&2
      return 2
    fi
    if ! security find-generic-password \
        -s "$GH_KEYCHAIN_SERVICE" \
        -a "$GH_KEYCHAIN_ACCOUNT" \
        -w 2>/dev/null; then
      cat >&2 <<MSG
sandbox-env: GH token not found in Keychain
  service: $GH_KEYCHAIN_SERVICE
  account: $GH_KEYCHAIN_ACCOUNT

To populate (one-time, then good until the token expires):
  security add-generic-password -s "$GH_KEYCHAIN_SERVICE" -a "$GH_KEYCHAIN_ACCOUNT" -w
  (paste your GitHub personal-access token at the prompt — no trailing newline)
MSG
      return 1
    fi
    return 0
  fi

  if [[ "$OSTYPE" == linux-gnu* ]]; then
    if command -v secret-tool >/dev/null 2>&1; then
      if ! secret-tool lookup service "$GH_KEYCHAIN_SERVICE" account "$GH_KEYCHAIN_ACCOUNT" 2>/dev/null; then
        cat >&2 <<MSG
sandbox-env: GH token not found in libsecret
  service: $GH_KEYCHAIN_SERVICE
  account: $GH_KEYCHAIN_ACCOUNT

To populate (one-time, then good until the token expires):
  secret-tool store --label=$GH_KEYCHAIN_SERVICE service $GH_KEYCHAIN_SERVICE account $GH_KEYCHAIN_ACCOUNT
  (paste your GitHub personal-access token at the prompt — no trailing newline)
MSG
        return 1
      fi
      return 0
    fi
    if command -v keyctl >/dev/null 2>&1; then
      # Same key name the runner's retrieve-secret.sh derives: service with
      # hyphens as underscores, then _<account>.
      local key_name="${GH_KEYCHAIN_SERVICE//-/_}_${GH_KEYCHAIN_ACCOUNT}"
      local key_id
      if ! key_id="$(keyctl search @s user "$key_name" 2>/dev/null)" \
          || ! keyctl pipe "$key_id" 2>/dev/null; then
        cat >&2 <<MSG
sandbox-env: GH token not found in the kernel keyring
  key: user $key_name (searched from the session keyring)

To populate (one-time, then good until the token expires):
  keyctl padd user $key_name @u
  (paste your GitHub personal-access token, then Ctrl-D — no trailing newline)
MSG
        return 1
      fi
      return 0
    fi
    echo "sandbox-env: no secret-store tool on this Linux host; install libsecret-tools (secret-tool) or keyutils (keyctl)" >&2
    return 2
  fi

  echo "sandbox-env: OS '$OSTYPE' is not supported by this script." >&2
  return 2
}

token=""
rc=0
token="$(retrieve_gh_token)" || rc=$?
if [[ $rc -ne 0 ]]; then
  exit "$rc"
fi

if [[ -z "$token" ]]; then
  echo "sandbox-env: secret-store entry found but token is empty" >&2
  exit 1
fi

printf 'GH_TOKEN=%s\n' "$token"

# Derive GH_REPO from the host repo's origin remote (resolved via CWD).
_repo_root=""
if ! _repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  echo "sandbox-env: not inside a git repository; cannot derive GH_REPO" >&2
  exit 1
fi

_origin_url=""
if ! _origin_url="$(git -C "$_repo_root" remote get-url origin 2>/dev/null)"; then
  echo "sandbox-env: host repository has no 'origin' remote; cannot derive GH_REPO" >&2
  exit 1
fi

_gh_host=""
_owner_repo=""

if [[ "$_origin_url" =~ ^git@([^:]+):(.+)$ ]]; then
  _gh_host="${BASH_REMATCH[1]}"
  _owner_repo="${BASH_REMATCH[2]%.git}"
elif [[ "$_origin_url" =~ ^ssh://([^@/]+@)?([^:/]+)(:[0-9]+)?/(.+)$ ]]; then
  _gh_host="${BASH_REMATCH[2]}"
  _owner_repo="${BASH_REMATCH[4]%.git}"
elif [[ "$_origin_url" =~ ^https://([^@/]+@)?([^/]+)/(.+)$ ]]; then
  _gh_host="${BASH_REMATCH[2]}"
  _owner_repo="${BASH_REMATCH[3]%.git}"
else
  echo "sandbox-env: origin remote '$_origin_url' is not a recognised SSH or HTTPS URL" >&2
  exit 1
fi

if [[ "$_gh_host" != "github.com" ]]; then
  echo "sandbox-env: origin remote hostname '$_gh_host' is not 'github.com'; only github.com is supported" >&2
  exit 1
fi

if [[ ! "$_owner_repo" =~ ^[^/]+/[^/]+$ ]]; then
  echo "sandbox-env: origin remote '$_origin_url' does not have owner/repo shape (got '$_owner_repo')" >&2
  exit 1
fi

printf 'GH_REPO=%s\n' "$_owner_repo"
